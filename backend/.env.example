# Copy to .env on the Tencent Cloud server and replace the value.
# Use separate long random values. API_TOKEN is a compatibility fallback;
# device/Hermes/public/admin roles should use their own tokens in production.
CHILDCARE_API_TOKEN=
CHILDCARE_DEVICE_TOKEN=replace-with-a-device-token
CHILDCARE_ADMIN_TOKEN=replace-with-an-admin-api-token
CHILDCARE_HERMES_TOKEN=replace-with-a-hermes-token
CHILDCARE_PUBLIC_READ_TOKEN=replace-with-a-public-read-token
CHILDCARE_ADMIN_PASSWORD=replace-with-a-console-password
CHILDCARE_SESSION_SECRET=replace-with-a-session-secret
CHILDCARE_PUBLIC_BASE_URL=https://your-domain.example
CHILDCARE_DB=/data/childcare.db
CHILDCARE_MEDIA_DIR=/data/media
CHILDCARE_SESSION_COOKIE_SECURE=1
