FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
WORKDIR /app
COPY --from=cloud_backup . /opt/cloud-backup
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --no-index --find-links=/opt/cloud-backup/vendor/wheels/linux-x86_64-cp312 --require-hashes -r /opt/cloud-backup/requirements.lock
COPY app ./app
COPY web ./web
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/opt/cloud-backup/src
ENV CLOUDBACKUP_ADMIN_UI=/opt/cloud-backup/admin/index.html
ENV CLOUDBACKUP_SKILL_DIR=/opt/cloud-backup/skills/cloud-backup-integrator
ENV CLOUDBACKUP_PROTOCOL_PATH=/opt/cloud-backup/docs/CLOUD-BACKUP-PROTOCOL.md
ENV CLOUDBACKUP_MIGRATIONS_DIR=/opt/cloud-backup/migrations
ENV CHILDCARE_DB=/config/childcare.db
ENV CHILDCARE_MEDIA_DIR=/childcare-media
EXPOSE 8080
CMD ["uvicorn", "app.unified:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
