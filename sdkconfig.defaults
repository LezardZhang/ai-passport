# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Full application font uses Flash-resident compressed bitmaps larger than 1 MiB.
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=n
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# The password keyboard and AI view need room for glyph draw buffers. The
# paged eight-track catalog returns about 4.9 KiB to the system heap.
CONFIG_LV_MEM_SIZE_KILOBYTES=28

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# Phone provisioning runs only during an explicit, bounded on-device window.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
# One advertiser and one connection; return packet blocks after use.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_NIMBLE_MEMPOOL_RUNTIME_ALLOC=y
# Preserve the no-PSRAM TLS budget while BLE is closed. Flash writes can
# briefly pause the radio; do not assume this board supports auto-suspend.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Allow mbedTLS to use the normal ESP heap on this no-PSRAM target. The
# internal-only allocator can leave a usable 4-8 KiB block unavailable after
# LVGL starts, which makes certificate verification fail.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# Reserve TLS buffers for each connection before allocating the audio queue.
# Per-record dynamic RX reallocation failed intermittently during replay even
# with the 12 kHz queue; release these buffers at HTTP client cleanup instead.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# MiMo audio sends full 16 KiB TLS records. An 8 KiB receive limit causes
# mbedtls_ssl_fetch_input() to fail with -0x7100 during SSE playback.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Keep the DMA interrupt active while the temporary speech cache is written.
CONFIG_I2S_ISR_IRAM_SAFE=y
